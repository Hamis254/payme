    .enum([
      'summary',
      'by_type',
      'monthly_trend',
      'top_spoiled',
      'highest_loss',
      'spoilage_rate',
    ])
    .default('summary')
    .describe(
      'Type of analysis: summary, by_type, monthly_trend, top_spoiled, highest_loss, spoilage_rate'
    ),
  limit: z.coerce
    .number()
    .int()
    .min(1)
    .max(100)
    .default(10)
    .describe('Number of items to return for list-based analyses'),
});

/**
