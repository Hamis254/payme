import { z } from 'zod';

/**
 * SPOILAGE TYPE ENUM
 * Standard categories for spoilage incidents
 */
const SPOILAGE_TYPES = [
  'expiration',
  'damage',
  'storage',
  'handling',
  'theft',
  'other',
];

/**
 * RECORD SPOILAGE SCHEMA
