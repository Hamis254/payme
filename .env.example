.env.example

# =====================
# Server Configuration
# =====================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# =====================
# Database Configuration
# =====================
DATABASE_URL=postgresql://payme_user:change_me@localhost:5432/payme_prod
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=10000
POSTGRES_DB=payme_prod
POSTGRES_USER=payme_user
POSTGRES_PASSWORD=change_me_in_production

# =====================
# Redis Configuration (Optional)
# =====================
REDIS_URL=redis://:change_me@localhost:6379
REDIS_PASSWORD=change_me
REDIS_PORT=6379
REDIS_DB=0

# =====================
# Authentication
# =====================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRY=7d

# =====================
# Security - Arcjet
# =====================
ARCJET_KEY=your-arcjet-api-key
CORS_ORIGIN=https://your-frontend-domain.com

# =====================
# M-Pesa Configuration
# =====================
MPESA_ENV=production
MPESA_CONSUMER_KEY=your-safaricom-consumer-key
MPESA_CONSUMER_SECRET=your-safaricom-consumer-secret

# Paybill Configuration
MPESA_SHORTCODE_PAYBILL=123456
MPESA_PASSKEY_PAYBILL=your-paybill-passkey

# Till Number Configuration
MPESA_SHORTCODE_TILL=654321
MPESA_PASSKEY_TILL=your-till-passkey

# Pochi la Biashara Configuration
MPESA_SHORTCODE_POCHI=789012
MPESA_PASSKEY_POCHI=your-pochi-passkey

# B2C (Business to Customer) Configuration
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_INITIATOR=your-initiator-name
MPESA_B2C_SECURITY_CREDENTIAL=your-encrypted-credential

# M-Pesa Callbacks
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_VALIDATION_URL=https://your-domain.com/api/mpesa/validation
# Sandbox only; ignored when MPESA_ENV=production.
MPESA_SKIP_IP_CHECK=true

# =====================
# Google Sheets Integration
# =====================
GOOGLE_SHEETS_API_KEY=your-google-api-key
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# =====================
# Email Configuration
# =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@payme.app

# =====================
# SMS Configuration (Twilio)
# =====================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =====================
# Monitoring & Error Tracking
# =====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key

# =====================
# Notifications
# =====================
NOTIFICATION_EMAIL=admin@payme.app
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# =====================
# Analytics
# =====================
GOOGLE_ANALYTICS_ID=G-your-ga-id
MIXPANEL_TOKEN=your-mixpanel-token
